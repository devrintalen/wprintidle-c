[Unit]
Description=Wayland Idle Time Monitor Daemon
Documentation=man:wprintidle-c(1)
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/wprintidle-c-daemon
Restart=on-failure
RestartSec=5

# Clean up socket on exit
ExecStopPost=/bin/sh -c 'rm -f ${XDG_RUNTIME_DIR}/wprintidle-c.sock'

[Install]
WantedBy=graphical-session.target
